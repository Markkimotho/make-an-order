# =============================================================================
# make-an-order — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Flask --------------------------------------------------------------------
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_URL=http://localhost:5001
# Reverse-proxy hops to trust (Heroku router = 1; add 1 per CDN/WAF in front)
PROXY_FIX_X_FOR=1
PROXY_FIX_X_PROTO=1

# --- Multi-tenancy ------------------------------------------------------------
# Fernet key encrypting each tenant's Daraja/eTIMS secrets at rest. Keep it
# safe: losing it makes stored secrets unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRETS_KEY=
# Emails allowed platform-admin rights; the flag itself is set only by
# `flask create-platform-admin` / `flask grant-platform-admin`
PLATFORM_ADMIN_EMAILS=

# --- MySQL (local dev) --------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=make_an_order
# In production (Heroku JawsDB), set JAWSDB_URL instead:
# JAWSDB_URL=mysql://user:pass@host/dbname

# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Africa's Talking SMS -----------------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- M-Pesa Daraja (Safaricom) ------------------------------------------------
# Each business enters its own Daraja keys at /settings. These old
# single-business values are only read by `flask tenants import-env-credentials`.
MPESA_ENV=sandbox                       # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=

# --- Flutterwave (card payments) ----------------------------------------------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
# Card payments are off by default (money settles to the platform account)
CARD_PAYMENTS_ENABLED=
# Optional: only accept Daraja webhooks from these IPs (comma-separated)
DARAJA_ALLOWED_IPS=

# --- Business / POS settings --------------------------------------------------
BUSINESS_NAME=SwiftPay POS
LOYALTY_POINTS_RATIO=10                 # KES spent per 1 loyalty point
TAX_RATE=0.16                           # 16% VAT
LOW_STOCK_DAYS=30                       # near-expiry window in days
MANAGER_OTP_TTL=300                     # seconds (5 min)

# --- Redis (used for manager-override OTPs; falls back to in-memory) ----------
REDIS_URL=redis://localhost:6379/0
