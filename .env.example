# =============================================================================
# make-an-order — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Flask --------------------------------------------------------------------
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_URL=http://localhost:5001

# --- MySQL (local dev) --------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=make_an_order
# In production (Heroku JawsDB), set JAWSDB_URL instead:
# JAWSDB_URL=mysql://user:pass@host/dbname

# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Africa's Talking SMS -----------------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- M-Pesa Daraja (Safaricom) ------------------------------------------------
MPESA_ENV=sandbox                       # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/payments/mpesa/callback

# --- Flutterwave (card payments) ----------------------------------------------
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=

# --- Business / POS settings --------------------------------------------------
BUSINESS_NAME=SwiftPay POS
LOYALTY_POINTS_RATIO=10                 # KES spent per 1 loyalty point
TAX_RATE=0.16                           # 16% VAT
LOW_STOCK_DAYS=30                       # near-expiry window in days
MANAGER_OTP_TTL=300                     # seconds (5 min)

# --- Redis (used for manager-override OTPs; falls back to in-memory) ----------
REDIS_URL=redis://localhost:6379/0
