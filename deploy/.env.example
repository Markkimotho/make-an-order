# =============================================================================
# make-an-order deploy settings. Copy to deploy/.env and fill in.
# Never commit deploy/.env. Passwords: letters and digits only (they go into
# a database URL), e.g. from `openssl rand -hex 24`.
# =============================================================================

# --- Which extras to run ---------------------------------------------------------
# Empty: local shop only. "tunnel": add Cloudflare Tunnel for online access.
# "vps": add Caddy with HTTPS. Both: "tunnel,vps" (rarely needed).
COMPOSE_PROFILES=

# --- Web --------------------------------------------------------------------------
# Long random string that signs logins. Generate: openssl rand -hex 32
APP_SECRET_KEY=change-me
# The address people use to open the app. Local shop: http://<server-ip>
# (see scripts/lan-address.sh). With a tunnel or VPS: https://your-domain.
# M-Pesa callback URLs are built from it, so it must be the public https URL
# once M-Pesa is live.
APP_URL=http://192.168.1.10
# Absolute base for links sent by SMS (pay links); usually the same as APP_URL
# when it is public. Daily reminders do not send without it.
PUBLIC_BASE_URL=
# Interface and port the app is published on. Local shop: 0.0.0.0 and 80 so
# every till can reach it. VPS: 127.0.0.1 and 8080 so only Caddy is public.
APP_BIND=0.0.0.0
APP_PORT=80
# Gunicorn worker processes (2 per CPU core is plenty for a shop).
WEB_CONCURRENCY=3
# Proxy hops to trust for the client IP (X-Forwarded-For). 0 when tills
# connect straight to the app on the LAN: trusting the header there would let
# anyone fake their IP and dodge the sign-in rate limit. Set 1 only when every
# request comes through Caddy (vps profile) or Cloudflare Tunnel.
PROXY_FIX_X_FOR=0
PROXY_FIX_X_PROTO=1
# Image tag for the locally built image.
APP_IMAGE_TAG=local

# --- Businesses and admins ----------------------------------------------------------
# true for one shop on its own server: the owner may download backups from
# Settings > Backup. false on a server shared by several businesses (a dump
# holds every business, so only platform admins may download).
SINGLE_BUSINESS_INSTALL=true
# Fernet key that encrypts each business's M-Pesa keys. Keep a copy offline:
# without it, restored M-Pesa keys cannot be read. Generate:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_SECRETS_KEY=
# Comma-separated emails allowed platform-admin rights.
PLATFORM_ADMIN_EMAILS=

# --- Database (MySQL 8.0 in the db service) ------------------------------------------
# Database and app user created on first start. Changing them later does not
# rename an existing database.
MYSQL_DB=mao
MYSQL_USER=mao
# The app user's password.
MYSQL_PASSWORD=change-me
# MySQL root password (only the db container uses it).
MYSQL_ROOT_PASSWORD=change-me

# --- Backups ----------------------------------------------------------------------------
# Where backups are written: the named volume "backups" (default), or a host
# folder such as /media/usb/mao-backups (owned by UID 1000: sudo chown 1000:1000 <folder>).
BACKUP_VOLUME=backups
# Back up when the newest backup is older than this many hours ...
BACKUP_EVERY_HOURS=20
# ... checking this often (minutes). Hourly checks catch up after the server
# was switched off at night.
BACKUP_CHECK_MINUTES=60
# Optional offsite copy after every backup, as an rclone remote:path, e.g.
# gdrive:mao-backups or b2:my-bucket/mao. Configure the remote with
# `rclone config` and put rclone.conf in RCLONE_CONFIG_DIR.
BACKUP_RCLONE_REMOTE=
# Host folder holding rclone.conf (mounted read-only).
RCLONE_CONFIG_DIR=./rclone
# Optional: a MySQL server URL (no database) where `flask backup verify` may
# create and drop a scratch database to test-restore each backup, e.g.
# mysql://root:<MYSQL_ROOT_PASSWORD>@db:3306 . Empty: checksum check only.
BACKUP_VERIFY_MYSQL_URL=

# --- Online access ------------------------------------------------------------------------
# Profile "tunnel": token of a Cloudflare Tunnel whose public hostname points
# at http://app:8000 (Cloudflare dashboard > Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
# Profile "vps": the domain Caddy serves with HTTPS (DNS A record to this server).
APP_DOMAIN=

# --- Google sign-in (optional; email and password login works without it) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Africa's Talking SMS (optional) ------------------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
